# Perfil resiliente. Referência de configuração: nunca foi aplicado.
# Copie para terraform.tfvars (ignorado pelo Git).

environment = "prod"
owner       = "seu-nome"

nat_gateway_mode     = "per_az"
enable_database      = true
enable_load_balancer = true
enable_service       = true

enable_alarms     = true
enable_cloudtrail = true
enable_budget     = true
budget_limit_usd  = 250
alert_email       = "voce@example.com"

# Com domínio próprio, informe o ARN de um certificado público do ACM.
# certificate_arn = "arn:aws:acm:us-east-1:111122223333:certificate/00000000-0000-0000-0000-000000000000"

force_destroy            = false
alb_deletion_protection  = true
db_instance_class        = "db.t4g.small"
db_allocated_storage     = 50
db_multi_az              = true
db_backup_retention_days = 14
db_deletion_protection   = true

task_cpu           = 512
task_memory        = 1024
container_insights = "enabled"
log_retention_days = 30
