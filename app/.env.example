# Copie para .env e substitua os valores. O arquivo .env nunca entra no Git.

# Identificação do nó nas respostas (app-01, app-02...). Se vazio, usa o hostname.
APP_NODE=app-local
APP_VERSION=1.1.0

# Conexão da aplicação: usuário sem permissão de DDL.
DB_HOST=postgres
DB_PORT=5432
DB_NAME=aegis
DB_USER=aegis_app
DB_PASSWORD=CHANGE_ME
# Local: disable. Em banco gerenciado: verify-full, com DB_SSLROOTCERT apontando para a CA.
DB_SSLMODE=disable
# DB_SSLROOTCERT=/etc/ssl/certs/db-ca.pem

# Alternativa compatível com a versão 1.0.0: uma única URL.
# DATABASE_URL=postgresql://aegis_app:CHANGE_ME@postgres:5432/aegis

# Usuário administrador, usado apenas pela migração (python -m app.migrate).
DB_ADMIN_USER=aegis_admin
DB_ADMIN_PASSWORD=CHANGE_ME

# Token exigido por POST /api/events no cabeçalho X-API-Key.
# Se vazio, o endpoint fica desabilitado (404).
EVENTS_API_TOKEN=CHANGE_ME
